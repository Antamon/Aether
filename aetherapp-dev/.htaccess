<IfModule mod_headers.c>
    # HTML and dynamic PHP are reusable only after revalidation.
    <FilesMatch "\.(?:html|php)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    # A bare asset URL must revalidate. A filemtime URL can be cached for a year.
    SetEnvIfExpr "%{QUERY_STRING} =~ m#(?:^|&)v=[A-Za-z0-9._-]+(?:&|$)#" aether_versioned_asset=1
    <FilesMatch "\.(?:css|js)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header always set Cache-Control "public, max-age=31536000, immutable" env=aether_versioned_asset
    </FilesMatch>

    # These two public coordination endpoints must always reach PHP.
    <FilesMatch "^(?:asset|version)\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Local secrets and example files are PHP includes, never HTTP endpoints.
<FilesMatch "^(?:db|config(?:\.local|\.example)|db\.legacy\.local)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Defense in depth if a private source directory is uploaded accidentally.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:tests|docs|sql|legacy)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "\.(?:sql|md|log|bak|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
